<Project>
  <PropertyGroup>
    <Version>0.3.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- override with SE2_GAME_DIR if the game is not in the default Steam library -->
    <GameDir Condition="'$(GameDir)' == ''">$(SE2_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineers2\Game2</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- compile against the installed game, never copy or ship its binaries -->
    <Reference Include="VRage.Library">
      <HintPath>$(GameDir)\VRage.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
