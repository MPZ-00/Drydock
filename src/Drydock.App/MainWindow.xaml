<Window x:Class="Drydock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drydock" Icon="pack://application:,,,/Assets/Drydock.ico" Width="1100" Height="720" MinWidth="720" MinHeight="420"
        xmlns:vm="clr-namespace:Drydock.App.ViewModels"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <vm:IconConverter x:Key="IconConverter" />
    </Window.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SavePicker" Grid.Column="0" MinWidth="280" ItemsSource="{Binding Saves}"
                      SelectedItem="{Binding SelectedSave}" DisplayMemberPath="Name" SelectionChanged="OnSaveChosen" />
            <StackPanel x:Name="TopBarMiddle" Grid.Column="1" Orientation="Horizontal" Margin="8,0">
                <TextBox Width="220" VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTip="Filter by ship, block or slot name"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="show all" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ShowAll}"
                          ToolTip="Also show grids that aren't yours and empty inventories" />
            </StackPanel>
            <StackPanel x:Name="TopBarRight" Grid.Column="2" Orientation="Horizontal">
                <Button Content="Start game" IsEnabled="{Binding CanStartGame}" Padding="10,4" Margin="0,0,12,0" Click="OnStartGame"
                        ToolTip="Start Space Engineers 2 through Steam" />
                <Button Content="{Binding SaveLabel}" IsEnabled="{Binding CanSave}" Padding="14,4" Margin="0,0,6,0" Click="OnSave"
                        ToolTip="Write the pending changes. A backup is made first." />
                <Button Content="Discard" Padding="10,4" Margin="0,0,6,0" Click="OnDiscard" />
                <Button Content="Backups" Padding="10,4" Margin="0,0,12,0" Click="OnBackups" IsEnabled="{Binding CanOpenBackups}" />
                <Menu VerticalAlignment="Center">
                    <MenuItem Header="Settings">
                        <MenuItem x:Name="ThemeMenu" Header="Theme">
                            <MenuItem Header="System" IsCheckable="True" Click="OnTheme" Tag="System" />
                            <MenuItem Header="Light" IsCheckable="True" Click="OnTheme" Tag="Light" />
                            <MenuItem Header="Dark" IsCheckable="True" Click="OnTheme" Tag="Dark" />
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Help">
                        <MenuItem Header="About Drydock" Click="OnAbout" />
                    </MenuItem>
                </Menu>
            </StackPanel>
        </Grid>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding Status}" />
            <Separator />
            <StatusBarItem Content="{Binding GameState}" />
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{Binding PendingCount, Mode=OneWay}" /><Run Text=" pending" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
        <Grid x:Name="Body" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TreeView x:Name="InventoryTree" Grid.Column="0" ItemsSource="{Binding Tree}" SelectedItemChanged="OnTreeSelection">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Label}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPending}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="DarkOrange" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
            <Grid Grid.Column="2">
                <DockPanel Margin="8,0,0,0">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPane}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding EditError}" Foreground="Firebrick" TextWrapping="Wrap" />
                    <Grid Grid.IsSharedSizeScope="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="10,0,10,4" Opacity="0.7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition SharedSizeGroup="Name" MinWidth="200" />
                                <ColumnDefinition SharedSizeGroup="Amount" />
                                <ColumnDefinition SharedSizeGroup="Mass" />
                                <ColumnDefinition SharedSizeGroup="State" />
                                <ColumnDefinition SharedSizeGroup="Status" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Item" />
                            <TextBlock Grid.Column="2" Text="Amount" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="3" Text="Mass" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="4" Text="State" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="5" Text="Status" Margin="12,0,0,0" />
                        </Grid>
                        <ListBox x:Name="RowList" Grid.Row="1" ItemsSource="{Binding PaneEntries}" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ContextMenuOpening="OnRowMenuOpening"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.CommandBindings>
                                <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyRows" />
                            </ListBox.CommandBindings>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy name" Tag="name" Click="OnCopyField" />
                                    <MenuItem Header="Copy item key" Tag="key" Click="OnCopyField" />
                                    <MenuItem Header="Copy item id" Tag="id" Click="OnCopyField" />
                                    <MenuItem Header="Copy row" Tag="row" Click="OnCopyField" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                            <Setter Property="Foreground" Value="DarkOrange" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                        <!-- a section heading is part of the list but not a row to select -->
                                        <DataTrigger Binding="{Binding IsSection}" Value="True">
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter Margin="10,0,10,0" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.Resources>
                                <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                                    <Border BorderBrush="#70808080">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0,2,0,0" />
                                                <Setter Property="Margin" Value="0,10,0,0" />
                                                <Style.Triggers>
                                                    <!-- no line above the first section, the column headings sit there -->
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    <StackPanel Margin="0,8,0,6">
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="Add item..." Padding="12,2" Click="OnAddItem" />
                                            <TextBlock Text="{Binding Ref}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding MassText}" />
                                            <ProgressBar Grid.Column="1" Height="8" Maximum="1" Value="{Binding MassFraction, Mode=OneWay}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MassOver}" Value="True">
                                                                <Setter Property="Foreground" Value="Firebrick" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StacksText}" />
                                            <ProgressBar Grid.Column="1" Height="8" Maximum="1" Value="{Binding StacksFraction, Mode=OneWay}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StacksOver}" Value="True">
                                                                <Setter Property="Foreground" Value="Firebrick" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Overrides}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="Firebrick" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </Border>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:RowViewModel}">
                                    <!-- a faint line between rows, grey with alpha so it works in light and dark -->
                                    <Border BorderBrush="#30808080" BorderThickness="0,0,0,1" Padding="0,4,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition SharedSizeGroup="Name" MinWidth="200" />
                                            <ColumnDefinition SharedSizeGroup="Amount" />
                                            <ColumnDefinition SharedSizeGroup="Mass" />
                                            <ColumnDefinition SharedSizeGroup="State" />
                                            <ColumnDefinition SharedSizeGroup="Status" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Source="{Binding Icon, Converter={StaticResource IconConverter}}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Key}" FontSize="11" Opacity="0.6" />
                                        </StackPanel>
                                        <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBox Text="{Binding AmountText, Mode=OneWay}" MinWidth="90" TextAlignment="Right"
                                                     LostFocus="OnAmountCommit" KeyDown="OnAmountKey" ToolTip="Type a new total, Enter to apply">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanEditAmount}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock Text="{Binding AmountText}" TextAlignment="Right" MinWidth="90" Padding="0,0,10,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanEditAmount}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Grid.Column="3" Text="{Binding MassText}" Margin="12,0,0,0" MinWidth="60" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding State}" Margin="12,0,0,0" MinWidth="50" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{Binding Status}" Margin="12,0,0,0" MinWidth="60" VerticalAlignment="Center" FontStyle="Italic" />
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="Remove" Padding="8,1" Margin="0,0,4,0" Click="OnRemove">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanRemove}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Revert" Padding="8,1" Click="OnRevert">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Edit}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.Resources>
                        </ListBox>
                    </Grid>
                </DockPanel>
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="12" Foreground="Firebrick">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
